# Copy this file to ".env" and paste your LiveKit project details.
# Without them the app still opens, but only in "no call" mode.

# Project URL, starts with wss://
LIVEKIT_URL=
# Project key and secret
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Server port (optional)
PORT=5173

# Extra domains allowed to open "npm run dev" (optional, comma separated).
# ngrok domains are already allowed.
ALLOWED_HOSTS=
